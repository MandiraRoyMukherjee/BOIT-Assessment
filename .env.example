# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL; local: docker compose up -d. Hosted: e.g. Neon)
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench

# LLM: "mock" works with no key; "openai" needs LLM_API_KEY
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (OpenAI, Azure proxy, local gateways)
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=30000

# Upload limits (Vercel serverless request body cap is ~4.5MB)
MAX_FILE_MB=2
MAX_FILES=5

# Client (Vite)
VITE_API_URL=http://localhost:4000

# Max analysis requests per IP per minute
RATE_LIMIT_PER_MIN=10
